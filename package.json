{
  "name": "@people-says/backend",
  "private": true,
  "type": "module",
  "scripts": { "dev": "tsx watch src/index.ts", "build": "tsc -p tsconfig.json", "lint": "tsc --noEmit -p tsconfig.json", "test": "tsx --test src/game/rules.test.ts", "db:status": "sequelize-cli db:migrate:status", "db:migrate": "sequelize-cli db:migrate", "db:undo": "sequelize-cli db:migrate:undo", "db:undo:all": "sequelize-cli db:migrate:undo:all", "db:seed": "sequelize-cli db:seed:all", "db:seed:questions": "sequelize-cli db:seed --seed questions.seeder.js", "db:seed:answers": "sequelize-cli db:seed --seed answers.seeder.js", "db:seed:undo": "sequelize-cli db:seed:undo:all", "db:init": "pnpm db:migrate && pnpm db:seed", "db:revert": "pnpm db:seed:undo && pnpm db:undo:all" },
  "dependencies": { "cors": "^2.8.5", "dotenv": "^16.4.7", "express": "^5.1.0", "helmet": "^8.1.0", "pg": "^8.13.1", "sequelize": "^6.37.5", "socket.io": "^4.8.1", "sqlite3": "^5.1.7", "zod": "^3.25.76" },
  "devDependencies": { "@types/cors": "^2.8.17", "@types/express": "^5.0.1", "@types/node": "^22.15.21", "sequelize-cli": "^6.6.5", "tsx": "^4.19.4", "typescript": "^5.8.3" }
}
