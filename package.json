{
  "name": "@people-says/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "prepare": "husky",
    "lint": "tsc --noEmit -p tsconfig.json && eslint --config eslint.commit.config.mjs .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test src/game/rules.test.ts",
    "db:status": "sequelize-cli db:migrate:status",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "db:seed:undo:all": "sequelize-cli db:seed:undo:all",
    "db:init": "pnpm db:migrate && pnpm db:seed",
    "db:revert": "pnpm db:seed:undo:all && pnpm db:migrate:undo:all"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "i18next": "^26.5.11",
    "i18next-fs-backend": "^2.6.9",
    "i18next-http-middleware": "^3.9.11",
    "morgan": "^1.12.1",
    "pg": "^8.13.1",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.21",
    "sequelize-cli": "^6.6.5",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "prettier": "^3.4.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.19.1"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
