{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm db:migrate && pnpm db:seed && pnpm build",
  "routes": [
    {
      "src": "/socket.io/(.*)",
      "dest": "/api/socket-io.ts"
    },
    {
      "src": "/socket.io",
      "dest": "/api/socket-io.ts"
    },
    {
      "src": "/api/socket.io/(.*)",
      "dest": "/api/socket-io.ts"
    },
    {
      "src": "/api/socket.io",
      "dest": "/api/socket-io.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/health",
      "dest": "/api/index.ts"
    }
  ]
}
